# Synthetic/local development only. Copy to .env and replace placeholders; never commit secrets.
# Oracle
ORACLE_PASSWORD=change-local-admin-password
DB_USER=clinevo
DB_PASSWORD=change-local-app-password
DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
DB_POOL_MAX=10
DB_POOL_MIN=2

# Spring Boot / API
PORT=8080
AI_SERVICE_URL=http://localhost:8000
MAIL_POLL_SECONDS=60
CLINEVO_API_KEY=replace-with-long-random-local-key
CORS_ORIGIN=http://localhost:4200
MAX_ATTACHMENT_BYTES=20971520
MAX_UPLOAD_SIZE=20MB
MAX_REQUEST_SIZE=25MB

# Durable job processing
JOB_POLL_MS=1000
JOB_RECOVERY_MS=30000
JOB_MAX_ATTEMPTS=3
JOB_BATCH_SIZE=4
JOB_RETRY_BASE_SECONDS=5
JOB_LEASE_SECONDS=300

# Test mailbox only
MAIL_HOST=imap.example.test
MAIL_PORT=993
MAIL_USERNAME=test-inbox@example.test
MAIL_PASSWORD=replace-with-test-mailbox-password
MAIL_FOLDER=INBOX
MAIL_SSL=true

# Optional structured LLM endpoint. Leave URL/model empty for deterministic offline mode.
LLM_API_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45

# AI service
MAX_PDF_BYTES=20971520
